<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/eventoRoot"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/bg">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:paddingBottom="24dp">

            <FrameLayout android:layout_width="match_parent" android:layout_height="184dp">
                <ImageView android:id="@+id/eventoBanner"
                    android:layout_width="match_parent" android:layout_height="116dp"
                    android:src="@drawable/evento_placeholder" android:scaleType="centerCrop"
                    android:importantForAccessibility="no" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
                    android:paddingHorizontal="16dp" android:paddingTop="16dp" android:gravity="center_vertical">
                    <ImageView android:id="@+id/eventoCapa"
                        android:layout_width="110dp" android:layout_height="160dp"
                        android:src="@drawable/evento_deboxe_capa" android:scaleType="fitCenter"
                        android:contentDescription="Capa do evento Deboxe" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical" android:paddingStart="16dp">
                        <TextView style="@style/EventoText" android:text="Deboxe"
                            android:textSize="22sp" android:textColor="@color/text_primary" android:textStyle="bold" />
                        <TextView style="@style/EventoText" android:text="05-09-2026 · Automotivo" android:layout_marginTop="4dp" />
                    </LinearLayout>
                </LinearLayout>
            </FrameLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:paddingHorizontal="16dp">
                <TextView style="@style/EventoText" android:text="Direção de Imperium Eventos" android:layout_marginTop="8dp" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:gravity="center_vertical" android:layout_marginTop="14dp">
                    <TextView style="@style/EventoText" android:text="4.2" android:textColor="#FF8A00"
                        android:textSize="26sp" android:textStyle="bold" />
                    <TextView style="@style/EventoText" android:layout_width="0dp" android:layout_weight="1"
                        android:layout_marginStart="8dp" android:text="média de\n12,4k avaliações" android:textSize="12sp" />
                    <androidx.appcompat.widget.AppCompatButton android:id="@+id/eventoPresenca" style="@style/EventoAction"
                        android:text="✓" android:contentDescription="Marcar presença" />
                    <androidx.appcompat.widget.AppCompatButton android:id="@+id/eventoFavorito" style="@style/EventoAction"
                        android:text="♥" android:contentDescription="Favoritar evento" />
                    <androidx.appcompat.widget.AppCompatButton android:id="@+id/eventoLista" style="@style/EventoAction"
                        android:text="≡" android:contentDescription="Adicionar às listas" />
                </LinearLayout>
                <TextView style="@style/EventoText" android:layout_width="match_parent"
                    android:layout_marginTop="18dp" android:lineSpacingExtra="5dp"
                    android:text="Após um apagão misterioso, uma investigadora precisa reconstruir a última noite de um bairro inteiro antes que as memórias desapareçam para sempre." />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp">
                    <TextView style="@style/EventoTag" android:text="Eletrofunk" />
                    <TextView style="@style/EventoTag" android:text="Automotivo" />
                    <TextView style="@style/EventoTag" android:text="Festa" />
                </LinearLayout>
                <TextView style="@style/EventoSection" android:text="ORGANIZAÇÃO DO EVENTO" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content">
                    <ImageView style="@style/EventoAvatar" android:src="@drawable/evento_organizacao_1" android:contentDescription="Integrante da organização 1" />
                    <ImageView style="@style/EventoAvatar" android:src="@drawable/evento_organizacao_2" android:contentDescription="Integrante da organização 2" />
                    <ImageView style="@style/EventoAvatar" android:src="@drawable/evento_organizacao_3" android:contentDescription="Integrante da organização 3" />
                    <ImageView style="@style/EventoAvatar" android:src="@drawable/evento_organizacao_4" android:contentDescription="Integrante da organização 4" />
                </LinearLayout>
                <TextView style="@style/EventoSection" android:text="CRÍTICAS RECENTES" />
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/divider" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="16dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
                    <TextView style="@style/EventoText" android:text="●" android:textColor="@color/green" android:textSize="24sp" android:layout_marginEnd="8dp" />
                    <TextView style="@style/EventoText" android:text="Mariana Alves" android:textColor="@color/text_primary" android:textStyle="bold" />
                    <TextView style="@style/EventoText" android:text="★★★★☆" android:textColor="@color/green" android:layout_marginStart="10dp" android:contentDescription="4 de 5 estrelas" />
                </LinearLayout>
                <TextView style="@style/EventoText" android:layout_width="match_parent"
                    android:layout_marginTop="8dp" android:lineSpacingExtra="4dp"
                    android:text="Organização do evento em geral estava excelente, só a fila do estacionamento que deixou a desejar." />
            </LinearLayout>
            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/divider" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="16dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
                    <TextView style="@style/EventoText" android:text="●" android:textColor="#35B6E0" android:textSize="24sp" android:layout_marginEnd="8dp" />
                    <TextView style="@style/EventoText" android:text="Thiago Ramos" android:textColor="@color/text_primary" android:textStyle="bold" />
                    <TextView style="@style/EventoText" android:text="★★★★★" android:textColor="@color/green" android:layout_marginStart="10dp" android:contentDescription="5 de 5 estrelas" />
                </LinearLayout>
                <TextView style="@style/EventoText" android:layout_marginTop="8dp" android:text="Ótimo set de house e eletro." />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/divider" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@color/surface" android:baselineAligned="false">
        <LinearLayout android:id="@+id/eventoInicio" style="@style/EventoNavItem"
            android:clickable="true" android:focusable="true" android:contentDescription="Início"
            android:background="?attr/selectableItemBackground">
            <ImageView style="@style/EventoNavIcon" android:src="@drawable/evento_nav_home" />
            <TextView style="@style/EventoNavLabel" android:text="Início" />
        </LinearLayout>
        <LinearLayout style="@style/EventoNavItem">
            <ImageView style="@style/EventoNavIcon" android:src="@drawable/evento_nav_place" />
            <TextView style="@style/EventoNavLabel" android:text="Cafés, bares e festas" />
        </LinearLayout>
        <LinearLayout style="@style/EventoNavItem">
            <ImageView style="@style/EventoNavIcon" android:src="@drawable/evento_nav_book" />
            <TextView style="@style/EventoNavLabel" android:text="Diário" />
        </LinearLayout>
        <LinearLayout style="@style/EventoNavItem">
            <ImageView style="@style/EventoNavIcon" android:src="@drawable/evento_nav_person" />
            <TextView style="@style/EventoNavLabel" android:text="Perfil" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
