<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Estilo "pai" dos estilos Gyn.* abaixo -->
    <style name="Gyn" />

    <!-- Deixa abas, botões e o calendário com o verde do app, sem mexer no tema do grupo -->
    <style name="ThemeOverlay.Gynboxd.Verde" parent="ThemeOverlay.Material3.Dark">
        <item name="colorPrimary">@color/green</item>
        <item name="colorOnPrimary">#000000</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
    </style>

    <style name="ThemeOverlay.Gynboxd.DatePicker" parent="ThemeOverlay.Material3.MaterialCalendar">
        <item name="colorPrimary">@color/green</item>
        <item name="colorOnPrimary">#000000</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
    </style>

    <style name="Gyn.CardEstatistica" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">@color/surface</item>
        <item name="strokeColor">@color/divider</item>
        <item name="cardCornerRadius">12dp</item>
    </style>

    <style name="Gyn.ValorEstatistica">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Gyn.LabelEstatistica">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">11sp</item>
    </style>

    <style name="Gyn.CantoArredondado">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">6dp</item>
    </style>

    <style name="Gyn.IndicadorNav" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">#2600E054</item>
    </style>

</resources>