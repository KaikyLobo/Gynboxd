<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Estilos usados só na tela Diário (DiarioActivity).
         parent="" evita que o Android procure um estilo "pai" chamado "Diario". -->

    <style name="Diario.CardEstatistica" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">@color/surface</item>
        <item name="strokeColor">@color/divider</item>
        <item name="cardCornerRadius">12dp</item>
    </style>

    <style name="Diario.ValorEstatistica" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Diario.LabelEstatistica" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">11sp</item>
    </style>
</resources>
