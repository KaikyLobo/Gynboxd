<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Base.Theme.Gynboxd" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:fontFamily">@font/inter</item>
        <item name="fontFamily">@font/inter</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="colorPrimary">@color/green</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
    </style>

    <style name="Theme.Gynboxd" parent="Base.Theme.Gynboxd"/>

    <style name="SectionTitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingHorizontal">16dp</item>
        <item name="android:paddingTop">16dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Bottom nav no estilo do Figma: barra baixa, sem pílula, rótulo 10sp -->
    <style name="Widget.Gynboxd.BottomNav" parent="Widget.Material3.BottomNavigationView">
        <item name="android:background">@color/surface</item>
        <item name="android:minHeight">56dp</item>
        <item name="elevation">0dp</item>
        <item name="itemPaddingTop">8dp</item>
        <item name="itemPaddingBottom">8dp</item>
        <item name="itemActiveIndicatorStyle">@style/Widget.Gynboxd.NavIndicator</item>
        <item name="itemTextAppearanceActive">@style/TextAppearance.Gynboxd.NavLabel</item>
        <item name="itemTextAppearanceInactive">@style/TextAppearance.Gynboxd.NavLabel</item>
    </style>

    <style name="Widget.Gynboxd.NavIndicator"
        parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@android:color/transparent</item>
    </style>

    <style name="TextAppearance.Gynboxd.NavLabel" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textSize">10sp</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>