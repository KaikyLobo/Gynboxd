<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Estilos COMPARTILHADOS por todas as telas.
         (Tema, SectionTitle e barra de navegação ficam em themes.xml) -->

    <!-- Formas para ShapeableImageView: app:shapeAppearanceOverlay="@style/..." -->
    <style name="ShapeAppearance.Gynboxd.Circulo" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <style name="ShapeAppearance.Gynboxd.Arredondado" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">6dp</item>
    </style>

    <!-- Calendário (MaterialDatePicker) com as cores do app -->
    <style name="ThemeOverlay.Gynboxd.DatePicker" parent="ThemeOverlay.Material3.MaterialCalendar">
        <item name="colorPrimary">@color/green</item>
        <item name="colorOnPrimary">@color/bg</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
    </style>
</resources>
